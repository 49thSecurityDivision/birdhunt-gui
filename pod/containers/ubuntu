FROM docker.io/ubuntu:latest

RUN apt update

# Unminimize - make roughly equivalent to Ubuntu server setup
RUN apt install -y unminimize
RUN yes | unminimize

# utilities
RUN apt install -y iputils-ping iproute2 nmap

# SSH
RUN echo ubuntu | passwd ubuntu -s
RUN apt install -y openssh-server
CMD /usr/sbin/sshd -D
